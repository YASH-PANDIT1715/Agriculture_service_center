        }
        .btn-back {
            display: inline-block;
            margin-top: 15px;
            text-decoration: none;
            color: #333;
        }
    </style>
</head>

<body>

<div class="box">

    <h2><?= htmlspecialchars($service['name']) ?></h2>

    <p>
        <b>Short Description:</b><br>
        <?= nl2br(htmlspecialchars($service['description'])) ?>
    </p>

    <p>
        <b>Service Details:</b><br>
        <?= nl2br(htmlspecialchars($service['service_detail'])) ?>
    </p>

    <p>
        <b>Price:</b> ₹ <?= htmlspecialchars($service['price']) ?>
    </p>

    <!-- ✅ BOOK SERVICE BUTTON -->
    <form method="POST" action="book_services.php">
        <input type="hidden" name="service_id"
               value="<?= $service['service_id'] ?>">
        <button type="submit" class="btn">
            Book Service
        </button>
    </form>

    <a class="btn-back" href="view_services.php">
        ⬅ Back to Services
    </a>

